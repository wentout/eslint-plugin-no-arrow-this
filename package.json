{
  "name": "eslint-plugin-no-arrow-this",
  "version": "1.3.0",
  "author": "went.out@gmail.com",
  "description": "ESLint rule plugin 4 warning \"this\" keyword inside of arrow functions",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf ./dist && mkdir ./dist && cp -r ./src/* ./dist",
    "prepack": "npm run build",
    "lint": "eslint src/ test/ example/",
    "test": "mocha && echo 'NOW let me show an Example!' && npm run example",
    "example": "node example/index.js",
    "postinstall": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wentout/eslint-plugin-no-arrow-this.git"
  },
  "keywords": [
    "eslint",
    "plugin",
    "eslintplugin",
    "eslint-plugin",
    "arrow-function",
    "this"
  ],
  "directories": {
    "lib": "dist/",
    "src": "src/",
    "example": "example/"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "example"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wentout/eslint-plugin-no-arrow-this/issues"
  },
  "homepage": "https://github.com/wentout/eslint-plugin-no-arrow-this#readme",
  "peerDependencies": {
    "eslint": ">=3.19.0"
  },
  "engines": {
    "node": ">=8.11.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "mocha": "^11.2.0"
  }
}
